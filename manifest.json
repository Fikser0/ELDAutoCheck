{
  "manifest_version": 3,
  "name": "ELDAutoCheck",
  "version": "1.5",
  "description": "Automatically checks common HOS checkboxes to save time and adds a sleek dark theme.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "eldautocheck@fikser0.github.io",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://trendyeld.com/*", "https://beta.trendyeld.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://trendyeld.com/*", "https://beta.trendyeld.com/*"],
      "css": ["dark-theme.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js", "dark-theme.css"],
      "matches": ["https://trendyeld.com/*", "https://beta.trendyeld.com/*"]
    }
  ]
}