{
  "manifest_version": 3,
  "name": "ELDAutoCheck",
  "version": "1.3",
  "description": "Automatically checks common HOS checkboxes to save time.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://trendyeld.com/*", "https://beta.trendyeld.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://trendyeld.com/*", "https://beta.trendyeld.com/*"],
      "css": [],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.js"],
      "matches": ["https://trendyeld.com/*", "https://beta.trendyeld.com/*"]
    }
  ]
}